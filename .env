# ─── ESMS Environment Variables ──────────────────────────────────────────────
# All EXPO_PUBLIC_ variables are bundled into the client build.
# DO NOT store secrets (private keys, DB credentials) here.
# Use a secrets manager / server-side env for sensitive values.

# API base URL — change for staging / production
EXPO_PUBLIC_API_BASE_URL=https://esms-api.vercel.app/

# App display name (cosmetic only; actual name in app.json)
EXPO_PUBLIC_APP_NAME=ESMS
