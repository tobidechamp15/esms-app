{
  "expo": {
    "name": "Ventry",
    "slug": "ventry",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ventry",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0A1628"
    },
    "ios": {
      "bundleIdentifier": "com.ventry.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Ventry uses the camera to scan visitor QR codes at the estate gate.",
        "NSPhotoLibraryUsageDescription": "Ventry needs access to your photos to attach images to concern reports.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ventry.app",
      "adaptiveIcon": {
        "backgroundColor": "#1B4FD8"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1628",
          "android": {
            "imageWidth": 120
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ventry uses the camera to scan visitor QR codes at the estate gate.",
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ventry needs access to your photos to attach images to concern reports."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4bdbadc1-411a-4c64-a700-422a2879ccf7"
      }
    },
    "owner": "tobilobaemma04"
  }
}
