# Ventry Environment Variables
# =============================
# ⚠️  SECURITY WARNING
# All EXPO_PUBLIC_* variables are bundled into the client build.
# NEVER store secrets, API keys, or passwords in EXPO_PUBLIC_ variables.
# =============================

# ─── API Configuration ────────────────────────────────────────────────────────
# REQUIRED: API base URL
# Use http:// for local development on same network
# Use https:// for production builds (enforced in code)
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.176:3000/api/v1
# Example production: EXPO_PUBLIC_API_BASE_URL=https://api.ventry.com/api/v1

# ─── App Display ──────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_NAME=Ventry
EXPO_PUBLIC_ESTATE_NAME=Lere Adigun
